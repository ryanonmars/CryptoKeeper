{
  "manifest_version": 3,
  "name": "TermKey Extension",
  "version": "1.0.2",
  "key": "",
  "description": "Autofill and credential manager",
  "permissions": ["storage", "activeTab", "scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["prompt.html", "public/icons/termkey-icon-32.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "icons": {
    "16": "public/icons/termkey-icon-16.png",
    "32": "public/icons/termkey-icon-32.png",
    "48": "public/icons/termkey-icon-48.png",
    "128": "public/icons/termkey-icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/icons/termkey-icon-16.png",
      "32": "public/icons/termkey-icon-32.png"
    }
  }
}
